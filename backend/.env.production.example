# Production Environment Variables for Backend
# Copy values to your production hosting environment

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Munus API
VERSION=1.0.0

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your_super_secure_secret_key_here_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Add your production domains
BACKEND_CORS_ORIGINS=["https://gomunus.com","https://www.gomunus.com","https://api.gomunus.com"]

# Environment
ENVIRONMENT=production
DEBUG=false

# MongoDB
MONGODB_URI=your_mongodb_production_uri_here
MONGODB_DB_NAME=Munusdb

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=https://gomunus.com/google-callback
FRONTEND_URL=https://gomunus.com

# OpenAI Configuration
OPENAI_API_KEY=your_production_openai_key_here

# Email Configuration (if using email features)
MAIL_USERNAME=noreply@gomunus.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@gomunus.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Munus

# Note: In Google Cloud Console, add these redirect URIs:
# - https://gomunus.com/google-callback
# - https://www.gomunus.com/google-callback

