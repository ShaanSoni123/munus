# Production Environment Variables Template for Munus Backend
# Copy this file to .env and fill in the actual values

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Munus API
VERSION=1.0.0
DESCRIPTION=AI-Powered Job Portal & Resume Builder API

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-here-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - MongoDB
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp
MONGODB_DB_NAME=jobify

# CORS - Add your actual frontend URLs
BACKEND_CORS_ORIGINS=["https://your-frontend-domain.com","https://www.your-frontend-domain.com"]

# Environment
ENVIRONMENT=production
DEBUG=false

# URLs
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.onrender.com

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Phone verification (SMS service not configured)
# If you want to add SMS verification, integrate with a service like Twilio, AWS SNS, etc.

# Email Configuration
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@your-domain.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Munus

# Google OAuth (for Google login and Drive integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.onrender.com/api/v1/auth/google/callback

# AWS (optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# Redis (optional - for caching and background tasks)
REDIS_URL=redis://your-redis-url:6379
